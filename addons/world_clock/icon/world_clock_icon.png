
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
    <!-- Blue left half of border -->
    <path
            d="M12 3 A9 9 0 0 0 12 21"
            fill="none"
            stroke="#3498db"
            stroke-width="2"
    />

    <!-- Red right half of border -->
    <path
            d="M12 3 A9 9 0 0 1 12 21"
            fill="none"
            stroke="#e74c3c"
            stroke-width="2"
    />

    <!-- White clock hands -->
    <path
            d="M12 7 V12 L16 14"
            fill="none"
            stroke="#ffffff"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
    />
</svg>
